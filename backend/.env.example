# Application
APP_NAME=AI Document Assistant
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-to-a-random-secret-key

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_pdf_db

# Redis
REDIS_URL=redis://localhost:6379/0

# AI Provider (FreeTheAI - FREE, OpenAI-compatible, 80+ models)
# HOW TO GET YOUR FREE KEY:
# 1. Go to https://discord.gg/freetheai
# 2. Run the /signup command
# 3. Copy your API key here
AI_API_BASE_URL=https://api.freetheai.xyz/v1
AI_API_KEY=your-free-key-from-discord
AI_MODEL=gpt-4o-mini
AI_MODEL_ADVANCED=gpt-4o
AI_FALLBACK_MODELS=["gpt-4o-mini","gpt-4o","claude-3-5-sonnet-20241022","gemini-1.5-flash"]

# JWT
JWT_SECRET_KEY=change-me-jwt-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Encryption (for user profile data)
ENCRYPTION_KEY=change-me-32-byte-encryption-key

# File Upload
MAX_UPLOAD_SIZE_MB=50
UPLOAD_DIR=./uploads

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]
