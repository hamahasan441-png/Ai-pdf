# Application
APP_NAME=AI Document Assistant
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-to-a-random-secret-key

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_pdf_db

# Redis
REDIS_URL=redis://localhost:6379/0

# AI Provider - OpenRouter (400+ models, OpenAI-compatible)
# Docs: https://openrouter.ai/docs
# Get key: https://openrouter.ai/keys
AI_API_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=your-openrouter-api-key-here
AI_MODEL=google/gemini-2.0-flash-exp:free
AI_MODEL_ADVANCED=google/gemini-2.5-flash-preview-05-20
AI_FALLBACK_MODELS=["google/gemini-2.0-flash-exp:free","google/gemini-2.5-flash-preview-05-20","meta-llama/llama-3.1-8b-instruct:free","qwen/qwen-2.5-72b-instruct:free","mistralai/mistral-7b-instruct:free"]

# JWT
JWT_SECRET_KEY=change-me-jwt-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Encryption (for user profile data)
ENCRYPTION_KEY=change-me-32-byte-encryption-key

# File Upload
MAX_UPLOAD_SIZE_MB=50
UPLOAD_DIR=./uploads

# Vision models for scanned/image documents (must support image input)
AI_VISION_MODELS=["google/gemini-2.0-flash-exp:free","meta-llama/llama-3.2-11b-vision-instruct:free","google/gemma-4-26b-a4b-it:free"]

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]

# Managed AI free-tier daily limit (Pro users are unlimited)
AI_FREE_DAILY_LIMIT=15

# Google Play Billing verification (server-side entitlement)
# Create a service account in Google Cloud, grant it access in Play Console
# (Users & permissions), enable the Android Publisher API, and paste the JSON.
GOOGLE_PLAY_PACKAGE_NAME=com.aidocassistant.app
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
PRODUCT_MONTHLY=pro_monthly
PRODUCT_YEARLY=pro_yearly
PRODUCT_LIFETIME=pro_lifetime
